DESS_USR=your@email.com
DESS_PWD=your-password
DESS_COMPANY_KEY=your-company-key

DESS_PN=your-device-pn
DESS_SN=your-device-sn
DESS_DEVCODE=6513
DESS_DEVADDR=1

POLL_INTERVAL_SECONDS=5
DESS_DB_PATH=data/solar.db
DESS_CONTROL_DB_PATH=data/solar-control.db
DESS_I18N=en_US
DESS_DASHBOARD_PORT=43871
DESS_UI_PORT=43872

# Optional for local UI development against a remote/tunneled API endpoint.
# Keep this empty for local API (default: http://127.0.0.1:${DESS_DASHBOARD_PORT}).
# Example: http://127.0.0.1:14387
DESS_DEV_API_TARGET=

# Optional helper values for `pnpm dev:ui:vps`.
# Keep defaults unless your SSH alias or remote API port is different.
DESS_VPS_SSH_HOST=solar-utf-sh
# DESS_VPS_SSH_BIN=C:/Windows/System32/OpenSSH/ssh.exe
# DESS_VPS_TUNNEL_REMOTE_HOST=127.0.0.1
# DESS_VPS_TUNNEL_REMOTE_PORT=43871
