DESS_USR=your@email.com
DESS_PWD=your-password
DESS_COMPANY_KEY=your-company-key

DESS_PN=your-device-pn
DESS_SN=your-device-sn
DESS_DEVCODE=6513
DESS_DEVADDR=1

POLL_INTERVAL_SECONDS=5
DESS_HTTP_TIMEOUT_MS=45000

# Growatt builds of the Rust backend (`--features growatt`) read these instead of the
# DESS_* device values above. Get the token in ShinePhone: Me > your account > API Token.
# GROWATT_TOKEN=your-api-token
# GROWATT_SN=your-inverter-serial
# GROWATT_API_URL=https://openapi.growatt.com
# Growatt builds default to POLL_INTERVAL_SECONDS=60 and keep at most 89 days of backfill.
# GROWATT_BACKFILL_DAYS=89
# GROWATT_STALE_SECONDS=900
DESS_DB_PATH=data/solar.db
DESS_CONTROL_DB_PATH=data/solar-control.db
DESS_I18N=en_US
DESS_DASHBOARD_PORT=43871
DESS_UI_PORT=43872

# Optional for local UI development against a remote/tunneled API endpoint.
# Keep this empty for local API (default: http://127.0.0.1:${DESS_DASHBOARD_PORT}).
# Example: http://127.0.0.1:14387
DESS_DEV_API_TARGET=

# Optional helper values for `pnpm dev:ui:vps`.
# Set your SSH host alias and tunnel target as needed.
DESS_VPS_SSH_HOST=your-vps-host
# DESS_VPS_SSH_BIN=C:/Windows/System32/OpenSSH/ssh.exe
# DESS_VPS_TUNNEL_REMOTE_HOST=127.0.0.1
# DESS_VPS_TUNNEL_REMOTE_PORT=43871

# Optional helper values for `scripts/deploy-vps.sh`.
# DESS_DEPLOY_SSH_HOST=your-vps-host
# DESS_DEPLOY_PUBLIC_URL=https://your-domain.example
# DESS_DEPLOY_ORIGIN_HOST_HEADER=your-domain.example
# DESS_DEPLOY_NGINX_SITE_PATH=/etc/nginx/sites-enabled/your-domain.example
